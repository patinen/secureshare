# Local development only. Copy to .env (never commit that file).
DATABASE_URL=postgres://secureshare_local:local_development_only@localhost:55432/secureshare_local?sslmode=disable
PORT=8080
WEB_ORIGIN=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
ENVIRONMENT=development
# Development-only private MinIO bucket. Blank endpoints use standard AWS S3.
S3_ENDPOINT=http://localhost:59000
# Optional browser-facing endpoint; Docker uses minio:9000 for uploads but
# localhost:59000 for signed downloads. Never rewrite a signed URL's host.
S3_DOWNLOAD_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=secureshare-local
S3_ACCESS_KEY_ID=secureshare_local
S3_SECRET_ACCESS_KEY=local_storage_development_only
S3_USE_PATH_STYLE=true
# Cleanup worker settings (also validated by API startup).
CLEANUP_INTERVAL=1m
FILE_RETENTION_GRACE=15m
PENDING_UPLOAD_GRACE=1h
# Empty defaults to <os temp>/secureshare-uploads. API and worker must share it.
UPLOAD_TEMP_DIR=
# API only; the cleanup worker does not need Redis or this HMAC secret.
REDIS_URL=redis://localhost:56379/0
# Generate independently of SESSION_SECRET; never commit the populated value.
RATE_LIMIT_KEY_SECRET=
# Comma-separated explicit trusted CIDRs; empty means direct peer only.
TRUSTED_PROXY_CIDRS=
MAX_STORED_FILE_BYTES_PER_USER=536870912
MAX_NONTERMINAL_SHARES_PER_USER=500
